include_guard(GLOBAL)

function(_aboleth_summary_line label value)
  string(LENGTH "${label}" _len)
  math(EXPR _pad "26 - ${_len}")
  if(_pad LESS 1)
    set(_pad 1)
  endif()
  string(REPEAT " " ${_pad} _spaces)
  message(STATUS "  ${label}${_spaces}${value}")
endfunction()

function(_aboleth_summary_feature name)
  if(ABOLETH_HAS_${name})
    _aboleth_summary_line("${name}" "yes")
  else()
    _aboleth_summary_line("${name}" "no")
  endif()
endfunction()

message(STATUS "")
message(STATUS "Aboleth ${PROJECT_VERSION} — ${CMAKE_BUILD_TYPE}")
_aboleth_summary_line("build tree" "${CMAKE_BINARY_DIR}")
_aboleth_summary_line("GPU backend" "${ABOLETH_GPU_BACKEND}")
if(ABOLETH_HAS_CUDA)
  _aboleth_summary_line("CUDA architectures" "${CMAKE_CUDA_ARCHITECTURES}")
endif()
_aboleth_summary_line("Python" "${Python_EXECUTABLE}")
_aboleth_summary_line("MLIR" "${MLIR_DIR}")
if(ABOLETH_HAS_TRITON_PLUGIN)
  _aboleth_summary_line("Triton" "${Triton_LIBRARY}")
endif()

message(STATUS "  features:")
foreach(feature IN LISTS ABOLETH_FEATURE_LIST)
  _aboleth_summary_feature(${feature})
endforeach()

message(STATUS "  components:")
_aboleth_summary_line("runtime" "${ABOLETH_BUILD_RUNTIME}")
_aboleth_summary_line("experiments" "${ABOLETH_BUILD_EXPERIMENTS}")
_aboleth_summary_line("tests" "${ABOLETH_ENABLE_TESTS}")
if(ABOLETH_HAS_EFA)
  _aboleth_summary_line("EFA bitcode archs" "${ABOLETH_EFA_BITCODE_ARCHS}")
endif()
message(STATUS "")
