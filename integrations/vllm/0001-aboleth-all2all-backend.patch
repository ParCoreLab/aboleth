+++ b/vllm/distributed/kv_transfer/kv_connector/v1/aboleth_connector.py
@@ -0,0 +1,290 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Same-node TP1 KV transfer through compiled Aboleth P2P phases."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+
+from aboleth.integrations import VLLMKVPeerRuntime
+from aboleth.kv import (
+    CompiledKVTransferManager,
+    KVCompletionNotification,
+    KVRuntimeOverrides,
+)
+from vllm.distributed.kv_transfer.kv_connector.v1.base import (
+    KVConnectorRole,
+)
+from vllm.distributed.kv_transfer.kv_connector.v1.nixl.connector import (
+    NixlBaseConnector,
+)
+from vllm.distributed.kv_transfer.kv_connector.v1.nixl.metadata import (
+    NixlConnectorMetadata,
+)
+from vllm.distributed.kv_transfer.kv_connector.v1.nixl.pull_scheduler import (
+    NixlPullConnectorScheduler,
+)
+from vllm.distributed.kv_transfer.kv_connector.v1.nixl.pull_worker import (
+    NixlPullConnectorWorker,
+)
+from vllm.distributed.kv_transfer.kv_connector.v1.nixl.tp_mapping import (
+    ReadSpec,
+)
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+    from vllm.v1.kv_cache_interface import KVCacheConfig
+
+
+class AbolethKVConnectorWorker(NixlPullConnectorWorker):
+    def __init__(
+        self,
+        vllm_config: "VllmConfig",
+        engine_id: str,
+        kv_cache_config: "KVCacheConfig",
+    ):
+        self._aboleth: VLLMKVPeerRuntime | None = None
+        super().__init__(
+            vllm_config,
+            engine_id,
+            kv_cache_config,
+        )
+        config = vllm_config.kv_transfer_config
+        assert config is not None
+        rank = config.kv_rank
+        if rank is None:
+            rank = (
+                0
+                if config.kv_role == "kv_producer"
+                else 1
+            )
+        world_size = (
+            2
+            if config.kv_parallel_size == 1
+            else config.kv_parallel_size
+        )
+        if world_size != 2:
+            raise NotImplementedError(
+                "AbolethConnector currently supports 1P1D"
+            )
+        port = config.get_from_extra_config(
+            "aboleth_store_port",
+            config.kv_port + 1000,
+        )
+        self._aboleth = VLLMKVPeerRuntime(
+            rank=rank,
+            world_size=world_size,
+            device=torch.cuda.current_device(),
+            host=config.kv_ip,
+            port=int(port),
+            overrides=KVRuntimeOverrides.from_mapping(
+                config.kv_connector_extra_config or {}
+            ),
+        )
+        self._aboleth_done: set[str] = set()
+        self._aboleth_manager = CompiledKVTransferManager(
+            self._aboleth
+        )
+
+    @property
+    def has_active_layer_events(self) -> bool:
+        return self._aboleth_manager.has_active_layers
+
+    def register_kv_caches(
+        self,
+        kv_caches: dict[str, torch.Tensor],
+    ):
+        super().register_kv_caches(kv_caches)
+        assert self._aboleth is not None
+        self._aboleth.register_kv_caches(
+            kv_caches,
+            consumer_order=tuple(kv_caches),
+        )
+
+    def start_load_kv(
+        self,
+        metadata: NixlConnectorMetadata,
+    ):
+        activated = self._aboleth_manager.begin_step(
+            set(metadata.reqs_not_processed)
+        )
+        if (
+            activated
+            and self._aboleth is not None
+            and self._aboleth.profile_transfers
+        ):
+            print(
+                "aboleth_kv_pipeline="
+                f"requests={activated} "
+                f"layers={self._aboleth_manager.active_layer_count}",
+                flush=True,
+            )
+        super().start_load_kv(metadata)
+
+    def wait_for_layer_load(self, layer_name: str):
+        stream = torch.cuda.current_stream()
+        self._aboleth_manager.wait_for_layer(
+            layer_name,
+            stream.wait_event,
+        )
+
+    def _read_blocks(
+        self,
+        read_spec: ReadSpec,
+        dst_engine_id: str,
+        request_id: str,
+        remote_request_id: str,
+        local_xfer_side_handle: int,
+        remote_xfer_side_handle: int,
+    ):
+        del local_xfer_side_handle, remote_xfer_side_handle
+        assert self.transfer_topo is not None
+        remote_info = self.transfer_topo.get_engine_info(
+            dst_engine_id
+        )
+        if (
+            self.world_size != 1
+            or remote_info.remote_tp_size != 1
+            or self.pp_size != 1
+            or len(read_spec.local_block_ids) != 1
+            or len(read_spec.remote_block_ids) != 1
+            or remote_info.remote_block_size != self.block_size
+            or remote_info.remote_physical_blocks_per_logical != 1
+            or self._physical_blocks_per_logical_kv_block != 1
+        ):
+            raise NotImplementedError(
+                "first Aboleth KV gate requires homogeneous TP1/PP1"
+            )
+        local_block_ids = list(
+            read_spec.local_block_ids[0]
+        )
+        remote_block_ids = list(
+            read_spec.remote_block_ids[0]
+        )
+        local_groups = [local_block_ids]
+        remote_groups = [remote_block_ids]
+        local_groups, remote_groups = (
+            self._apply_prefix_caching(
+                local_groups,
+                remote_groups,
+                1,
+            )
+        )
+        local_block_ids = local_groups[0]
+        remote_block_ids = remote_groups[0]
+        notif_id = (
+            f"{remote_request_id}:{self.world_size}"
+        ).encode()
+        agent_name = self._remote_agents[
+            dst_engine_id
+        ][(0, read_spec.remote_rank)]
+        assert self._aboleth is not None
+        tracked = self._aboleth_manager.start_transfer(
+            request_id=request_id,
+            local_block_ids=local_block_ids,
+            remote_block_ids=remote_block_ids,
+            remote_rank=1 - self._aboleth.rank,
+            notification=KVCompletionNotification(
+                target=agent_name,
+                payload=notif_id,
+            ),
+        )
+        if tracked:
+            self._recving_transfers.setdefault(
+                request_id,
+                [],
+            )
+        else:
+            self.nixl_wrapper.send_notif(
+                agent_name,
+                notif_msg=notif_id,
+            )
+            self._aboleth_done.add(request_id)
+
+    def _pop_done_transfers(self, transfers):
+        if transfers is self._recving_transfers:
+            done = set(self._aboleth_done)
+            self._aboleth_done.clear()
+            poll = self._aboleth_manager.poll()
+            done.update(poll.ready_request_ids)
+            for notification in poll.notifications:
+                self.nixl_wrapper.send_notif(
+                    notification.target,
+                    notif_msg=notification.payload,
+                )
+            for request_id in done:
+                transfers.pop(request_id, None)
+            return done
+        return super()._pop_done_transfers(transfers)
+
+    def shutdown(self):
+        if self._aboleth is not None:
+            self._aboleth.close()
+            self._aboleth = None
+        super().shutdown()
+
+
+class AbolethConnector(NixlBaseConnector):
+    """NIXL control plane with Aboleth compiled KV data movement."""
+
+    @classmethod
+    def requires_piecewise_for_cudagraph(
+        cls,
+        extra_config,
+    ) -> bool:
+        del extra_config
+        return True
+
+    def __init__(
+        self,
+        vllm_config: "VllmConfig",
+        role: KVConnectorRole,
+        kv_cache_config: "KVCacheConfig",
+    ):
+        super().__init__(
+            vllm_config,
+            role,
+            kv_cache_config,
+        )
+        if role == KVConnectorRole.SCHEDULER:
+            self.connector_scheduler = (
+                NixlPullConnectorScheduler(
+                    vllm_config,
+                    self.engine_id,
+                    kv_cache_config,
+                )
+            )
+        elif role == KVConnectorRole.WORKER:
+            self.connector_worker = AbolethKVConnectorWorker(
+                vllm_config,
+                self.engine_id,
+                kv_cache_config,
+            )
+        else:
+            raise ValueError(
+                f"unsupported connector role: {role}"
+            )
+
+    def wait_for_layer_load(self, layer_name: str):
+        worker = self.connector_worker
+        if (
+            isinstance(worker, AbolethKVConnectorWorker)
+            and worker.has_active_layer_events
+        ):
+            worker.wait_for_layer_load(layer_name)
+
+    def start_load_kv(self, forward_context, **kwargs):
+        del forward_context, kwargs
+        assert self.connector_worker is not None
+        assert isinstance(
+            self.connector_worker,
+            AbolethKVConnectorWorker,
+        )
+        assert isinstance(
+            self._connector_metadata,
+            NixlConnectorMetadata,
+        )
+        self.connector_worker.start_load_kv(
+            self._connector_metadata
+        )
