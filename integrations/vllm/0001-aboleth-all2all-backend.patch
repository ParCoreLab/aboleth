+class AbolethAll2AllManager(All2AllManagerBase):
+    """Expert-parallel communication through Aboleth's runtime manager."""
+
+    def __init__(self, cpu_group, tcp_store_group=None, device_group=None):
+        assert has_aboleth(), (
+            "The Aboleth package is unavailable. Install the sibling Aboleth "
+            "checkout and set VLLM_ENABLE_ABOLETH=1 before importing vLLM."
+        )
+        super().__init__(cpu_group, tcp_store_group)
+        if self.world_size < 2 or self.world_size != self.dp_world_size:
+            raise NotImplementedError(
+                "Aboleth requires matching EP/DP groups with at least two ranks"
+            )
+        if self.tp_group.world_size != 1:
+            raise NotImplementedError(
+                "the first Aboleth gate requires tensor parallel size one"
+            )
+        import aboleth
+        from aboleth.integrations.compiled_vllm import AbolethMoERuntimeManager
+
+        self._runtime = AbolethMoERuntimeManager(
+            rank=self.rank,
+            world_size=self.world_size,
+            device=torch.cuda.current_device(),
+            bootstrap=aboleth.TorchDistributedBootstrap(cpu_group),
+            internode=self.internode,
+        )
+
+    def get_handle(self, kwargs):
+        config = get_current_vllm_config().parallel_config
+        consumer_kwargs = dict(kwargs)
+        if consumer_kwargs.get("quant_dtype") is not None:
+            from vllm.utils.deep_gemm import is_deep_gemm_e8m0_used
+            consumer_kwargs["quant_round_scale"] = is_deep_gemm_e8m0_used()
+        return self._runtime.get_handle(
+            consumer_kwargs,
+            num_slots=config.num_ubatches if config.use_ubatching else 1,
+            placement_strategy=config.expert_placement_strategy,
+        )
+
+    def destroy(self):
+        self._runtime.close()
