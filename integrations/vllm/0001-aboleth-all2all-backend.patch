--- /dev/null
+++ b/vllm/model_executor/layers/fused_moe/prepare_finalize/aboleth.py
@@ -0,0 +1,251 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from aboleth.integrations.compiled_vllm import ModularMoERuntime
+import torch
+
+import vllm.model_executor.layers.fused_moe.modular_kernel as mk
+from vllm.forward_context import (
+    get_forward_context,
+    is_forward_context_available,
+)
+from vllm.model_executor.layers.fused_moe.config import FusedMoEQuantConfig
+from vllm.v1.worker.ubatching import (
+    dbo_current_ubatch_id,
+    dbo_enabled,
+    dbo_switch_to_comm,
+    dbo_switch_to_compute,
+    dbo_switch_to_compute_sync,
+    dbo_yield_and_switch_from_compute_to_comm,
+    dbo_yield_and_switch_from_comm_to_compute,
+)
+
+__all__ = [
+    "AbolethPrepareAndFinalize",
+]
+
+
+def _record_handoff_tensors(*tensors):
+    # Tensor storage can outlive its last Python reference on another stream.
+    # Endpoint storage is persistent; temporary route/weight tensors are not.
+    if dbo_enabled():
+        stream = torch.cuda.current_stream()
+        for tensor in tensors:
+            if tensor is not None and tensor.is_cuda:
+                tensor.record_stream(stream)
+
+
+def _record_prepared_tensors(prepared):
+    x, scale, metadata, ids, weights = prepared
+    _record_handoff_tensors(x, scale, ids, weights)
+    if metadata is not None:
+        _record_handoff_tensors(metadata.expert_num_tokens)
+
+
+class AbolethPrepareAndFinalize(mk.FusedMoEPrepareAndFinalizeModular):
+    def __init__(
+        self,
+        handle,
+        *,
+        rank_expert_offset: int = 0,
+        layer_name: str = "",
+    ):
+        super().__init__()
+        self._async_enabled = handle.slots > 1
+        self._runtime = ModularMoERuntime(
+            handle,
+            rank_expert_offset=rank_expert_offset,
+            layer_name=layer_name,
+            slot_provider=dbo_current_ubatch_id,
+        )
+
+    def num_dispatchers(self) -> int:
+        return self._runtime.num_dispatchers()
+
+    def output_is_reduced(self) -> bool:
+        return self._runtime.output_is_reduced()
+
+    @property
+    def activation_format(self) -> mk.FusedMoEActivationFormat:
+        return mk.FusedMoEActivationFormat.Standard
+
+    def max_num_tokens_per_rank(self) -> int | None:
+        return self._runtime.max_num_tokens_per_rank()
+
+    def topk_indices_dtype(self) -> torch.dtype | None:
+        return self._runtime.topk_indices_dtype()
+
+    def expert_output_alias(
+        self,
+        expert_input: torch.Tensor,
+    ) -> torch.Tensor | None:
+        return self._runtime.expert_output_alias(expert_input)
+
+
+    def _wave_uniform_tokens(self, required_tokens: int) -> int:
+        """Agree once per forward on the bound used to select a shape variant.
+
+        Idle DP ranks may carry dummy local token counts. A CPU maximum keeps
+        every rank in the same communication variant; graph sizes already agree.
+        """
+        if not getattr(self._runtime, "has_decode_sibling", False):
+            return required_tokens
+        if torch.cuda.is_current_stream_capturing():
+            return required_tokens
+        from vllm.distributed.parallel_state import get_dp_group
+
+        try:
+            group = get_dp_group()
+        except AssertionError:
+            return required_tokens
+        if group.world_size <= 1:
+            return required_tokens
+        context = (
+            get_forward_context()
+            if is_forward_context_available()
+            else None
+        )
+        # Keyed per micro-batch: under dual-batch overlap the two
+        # ubatches of one forward have independent token bounds, and
+        # reusing ubatch 0's max for ubatch 1 would re-open the
+        # divergence for a prefill that only ubatch 1 carries.
+        cache_key = f"_aboleth_wave_tokens_{dbo_current_ubatch_id()}"
+        cached = (
+            getattr(context, cache_key, None)
+            if context is not None
+            else None
+        )
+        if cached is not None:
+            # cached is the max over every rank's bound for this wave
+            # and ubatch, so it dominates all locals; returning it
+            # unmixed is what keeps the selection rank-uniform.
+            return cached
+        bound = torch.tensor([required_tokens], dtype=torch.int64)
+        torch.distributed.all_reduce(
+            bound,
+            op=torch.distributed.ReduceOp.MAX,
+            group=group.cpu_group,
+        )
+        wave_tokens = int(bound.item())
+        if context is not None:
+            try:
+                setattr(context, cache_key, wave_tokens)
+            except AttributeError:
+                pass
+        return wave_tokens
+
+    def prepare(
+        self,
+        a1: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        num_experts: int,
+        expert_map: torch.Tensor | None,
+        apply_router_weight_on_input: bool,
+        quant_config: FusedMoEQuantConfig,
+        defer_input_quant: bool = False,
+    ) -> mk.PrepareResultType:
+        actual_tokens = int(a1.shape[0])
+        dp_metadata = (
+            get_forward_context().dp_metadata
+            if is_forward_context_available()
+            else None
+        )
+        required_tokens = max(
+            actual_tokens,
+            (
+                int(dp_metadata.num_tokens_across_dp_cpu.max())
+                if dp_metadata is not None
+                else actual_tokens
+            ),
+        )
+        required_tokens = self._wave_uniform_tokens(required_tokens)
+        prepared = self._runtime.prepare(
+            a1,
+            topk_weights,
+            topk_ids,
+            num_experts=num_experts,
+            expert_map=expert_map,
+            apply_router_weight_on_input=apply_router_weight_on_input,
+            required_tokens=required_tokens,
+            quantized_input=quant_config.quant_dtype is not None,
+            defer_input_quant=defer_input_quant,
+        )
+        expert_tokens_meta = (
+            mk.ExpertTokensMetadata(
+                expert_num_tokens=prepared.local_counts,
+                expert_num_tokens_cpu=None,
+            )
+            if prepared.local_counts is not None
+            else None
+        )
+        return (
+            prepared.expert_input,
+            prepared.scales,
+            expert_tokens_meta,
+            prepared.global_ids,
+            prepared.expert_weights,
+        )
+
+    def finalize(
+        self,
+        output: torch.Tensor,
+        fused_expert_output: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        apply_router_weight_on_input: bool,
+        weight_and_reduce_impl: mk.TopKWeightAndReduce,
+    ) -> None:
+        self._runtime.finalize(output, fused_expert_output)
+
+    def supports_async(self) -> bool:
+        return self._async_enabled
+
+    def prepare_async(
+        self,
+        a1: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        num_experts: int,
+        expert_map: torch.Tensor | None,
+        apply_router_weight_on_input: bool,
+        quant_config: FusedMoEQuantConfig,
+        defer_input_quant: bool = False,
+    ) -> mk.ReceiverType:
+        # The helper records this microbatch's input-ready event before
+        # yielding, then puts communication on the engine's comm stream.
+        dbo_yield_and_switch_from_compute_to_comm()
+        _record_handoff_tensors(a1, topk_weights, topk_ids)
+        prepared = self.prepare(
+            a1, topk_weights, topk_ids, num_experts, expert_map,
+            apply_router_weight_on_input, quant_config, defer_input_quant,
+        )
+        dbo_switch_to_compute_sync()
+        _record_prepared_tensors(prepared)
+        return lambda: prepared
+
+    def finalize_async(
+        self,
+        output: torch.Tensor,
+        fused_expert_output: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+        apply_router_weight_on_input: bool,
+        weight_and_reduce_impl: mk.TopKWeightAndReduce,
+    ):
+        dbo_yield_and_switch_from_compute_to_comm()
+        _record_handoff_tensors(output, fused_expert_output)
+        self.finalize(
+            output, fused_expert_output, topk_weights, topk_ids,
+            apply_router_weight_on_input, weight_and_reduce_impl,
+        )
+        # The engine may enqueue shared-expert computation before calling
+        # this receiver, matching its existing DeepEP HT handoff contract.
+        dbo_switch_to_compute()
+
+        def receive():
+            dbo_switch_to_comm()
+            dbo_yield_and_switch_from_comm_to_compute()
+            _record_handoff_tensors(output)
+
+        return receive
